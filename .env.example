# Koha REST API (staff interface address). Turn on the system preference
# RESTOAuth2ClientCredentials, then create a dedicated API staff patron with ONLY:
#   catalogue
#   borrowers > list_borrowers          (read patron record)
#   borrowers > api_validate_password   (check OPAC logins)
#   circulate > circulate_remaining_permissions  (read checkouts)
# Create its API key: patron page > More > Manage API keys.
# Local Ubuntu PC: use the staff port of instance "bpoly" (see README).
KOHA_BASE_URL=http://127.0.0.1:8080
KOHA_CLIENT_ID=replace-me
KOHA_CLIENT_SECRET=replace-me

# Patron field that stores the student's programme (sort1 = statistics_1)
PROGRAMME_FIELD=statistics_1

# Quest data
QUEST_DB=/opt/koha-quest-agent/quests.db
QUEST_TEMPLATES=/opt/koha-quest-agent/quests.json
LIBRARY_INFO=/opt/koha-quest-agent/library_info.json

# Agent service
AGENT_SECRET=replace-with-a-long-random-string
AGENT_HOST=0.0.0.0
AGENT_PORT=8765
# Exact OPAC address as typed in the browser, e.g. http://192.168.1.20 or http://192.168.1.20:8001
OPAC_ORIGIN=http://YOUR-PC-IP

# Language model: any OpenAI-compatible chat API with tool calling.
# A. Ollama on another, stronger PC in the library (recommended for a Lenovo E49-class PC):
#      on that PC: OLLAMA_HOST=0.0.0.0 ollama serve ; ollama pull qwen2.5:7b
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# B. Hosted provider: set its OpenAI-compatible URL, your key and a model that supports tools.
#    Conversations (including the student's first name and loan due dates) are then sent to that provider.
# LLM_BASE_URL=https://provider.example/v1
# LLM_API_KEY=your-key
# LLM_MODEL=provider-model-name
LLM_TIMEOUT=300
